---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  noindex?: boolean;
}

const { title, description, eyebrow, heading, intro, noindex } = Astro.props;
---

<BaseLayout {title} {description} {noindex}>
  <main id="contenido" tabindex="-1">
    <header class="page-hero">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {intro && <p class="lead">{intro}</p>}
    </header>
    <slot />
  </main>
</BaseLayout>

<style>
  .page-hero { max-width: 70rem; margin-inline: auto; padding: clamp(6rem, 12vw, 10rem) 1.25rem 4rem; text-align: center; }
  .eyebrow { color: #00ff7f; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.6rem, 7vw, 5.5rem); line-height: .98; }
  .lead { max-width: 48rem; margin: 1.5rem auto 0; color: var(--text-secondary); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.7; }
</style>
