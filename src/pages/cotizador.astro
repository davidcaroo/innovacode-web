---
import QuoteCalculator from '../components/islands/QuoteCalculator';
import MarketingLayout from '../layouts/MarketingLayout.astro';
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
---
<MarketingLayout title="Cotizador de páginas web | InnovaCode" description="Obtén una estimación inicial para landing pages, sitios informativos y tiendas online, y conversa con InnovaCode sobre el alcance." eyebrow="Estimación inicial" heading="Cotiza tu proyecto web" intro="Configura una referencia de inversión. La propuesta final depende del alcance, contenido, integraciones y tiempos acordados.">
  <QuoteCalculator client:load {whatsappNumber} />
</MarketingLayout>
<style is:global>
  .quote-shell{display:grid;grid-template-columns:minmax(0,2fr) minmax(18rem,1fr);gap:1.25rem;max-width:80rem;margin:0 auto;padding:0 1.25rem 7rem}.quote-options{margin:0;padding:0;border:0}.quote-options legend{margin-bottom:1.25rem;font-size:1.5rem;font-weight:800}.quote-projects{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}.quote-card{display:flex;flex-direction:column;gap:.75rem;padding:1.25rem;background:var(--bg-card);border:1px solid var(--border-primary);border-radius:1rem;cursor:pointer}.quote-card.active{border-color:#00ff7f}.quote-card input{accent-color:#00ff7f}.quote-card span,.quote-summary small{color:var(--text-secondary)}.quote-card b{margin-top:auto;color:#00ff7f}.quote-control,.quote-toggle{display:flex;gap:1rem;margin-top:1rem;padding:1.5rem;background:var(--bg-card);border:1px solid var(--border-primary);border-radius:1rem}.quote-control{flex-direction:column}.quote-control input{width:100%;accent-color:#00ff7f}.quote-toggle{align-items:flex-start}.quote-toggle input{width:1.3rem;height:1.3rem;accent-color:#00ff7f}.quote-toggle span{display:grid;gap:.3rem}.quote-toggle small{color:var(--text-secondary)}.quote-summary{position:sticky;top:6rem;align-self:start;display:grid;gap:1rem;padding:2rem;background:linear-gradient(145deg,var(--bg-card),var(--bg-secondary));border:1px solid #00ff7f;border-radius:1.25rem}.quote-summary p{margin:0;color:var(--text-secondary)}.quote-summary>strong{font-size:2rem}.quote-summary>span{font-size:1.2rem}.quote-summary a{padding:.9rem 1rem;color:#0c0c0c;background:#00ff7f;border-radius:999px;text-align:center;font-weight:800;text-decoration:none}@media(max-width:850px){.quote-shell{grid-template-columns:1fr}.quote-projects{grid-template-columns:1fr}.quote-summary{position:static}}
</style>
